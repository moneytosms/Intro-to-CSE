---
import Layout from '@/layouts/Layout.astro';

const resourceSections = [
  {
    title: 'Roadmaps & Guides',
    description: 'Step-by-step paths for learning CS and planning your growth.',
    links: [
      { name: 'roadmap.sh', href: 'https://roadmap.sh/', description: 'Learning paths for many developer roles and technologies.' },
      { name: 'The Odin Project', href: 'https://www.theodinproject.com/', description: 'Open, project-based web development curriculum.' },
      { name: 'Teach Yourself CS', href: 'https://teachyourselfcs.com/', description: 'Subject-wise guide to strong CS fundamentals.' },
      { name: 'freeCodeCamp', href: 'https://www.freecodecamp.org/', description: 'Structured beginner-friendly coding paths and certifications.' },
    ],
  },
  {
    title: 'Documentation & References',
    description: 'Authoritative docs, language references, and quick lookups.',
    links: [
      { name: 'DevDocs', href: 'https://devdocs.io/', description: 'Unified docs for many popular frameworks and languages.' },
      { name: 'MDN Web Docs', href: 'https://developer.mozilla.org/', description: 'Trusted reference for web technologies.' },
      { name: 'C++ Reference', href: 'https://cplusplus.com/reference/', description: 'Quick C++ standard library and language reference.' },
      { name: 'Quickref.me', href: 'https://quickref.me/', description: 'Compact cheat sheets for fast revision.' },
    ],
  },
  {
    title: 'Practice & Problem-Solving',
    description: 'Coding challenge platforms for interview prep and DSA practice.',
    links: [
      { name: 'NeetCode', href: 'https://neetcode.io/roadmap', description: 'Popular roadmap with curated LeetCode practice.' },
      { name: 'LeetCode', href: 'https://leetcode.com/', description: 'Most-used interview preparation platform.' },
      { name: 'CSES', href: 'https://cses.fi/problemset/', description: 'Well-curated problems to sharpen algorithmic thinking.' },
      { name: 'Exercism', href: 'https://exercism.org/', description: 'Practice many programming languages with mentoring.' },
      { name: 'Striver Sheets', href: 'https://takeuforward.org/', description: 'Widely used DSA sheets and problem sets.' },
    ],
  },
  {
    title: 'Courses & Lectures',
    description: 'Free and high-quality courses from universities and creators.',
    links: [
      { name: 'MIT OpenCourseWare', href: 'https://ocw.mit.edu/', description: 'Full university courses across CS topics.' },
      { name: 'CS50', href: 'https://cs50.harvard.edu/x/', description: 'One of the most popular CS intro courses.' },
      { name: 'Coursera', href: 'https://www.coursera.org/', description: 'MOOCs from top universities and companies.' },
      { name: 'Computerphile (YouTube)', href: 'https://www.youtube.com/c/Computerphile', description: 'Concept-first videos on CS topics.' },
    ],
  },
  {
    title: 'Books & Archives',
    description: 'Books and long-form references for deeper understanding.',
    links: [
      { name: 'Think Python', href: 'https://greenteapress.com/wp/think-python/', description: 'Beginner-friendly Python book.' },
      { name: 'Eloquent JavaScript', href: 'https://eloquentjavascript.net/', description: 'Modern and practical JavaScript book.' },
      { name: 'Internet Archive: Texts', href: 'https://archive.org/details/texts', description: 'Large archive of books and educational texts.' },
    ],
  },
  {
    title: 'Alternative Archives',
    description: 'Discreet sources for academic material (use responsibly).',
    links: [
      { name: 'Library Genesis (LibGen)', href: 'https://libgen.is/', description: 'Large index for books and papers.' },
      { name: 'Sci-Hub', href: 'https://sci-hub.se/', description: 'Academic paper access portal.' },
    ],
  },
  {
    title: 'Research & Academic Resources',
    description: 'Search engines and repositories for papers and preprints.',
    links: [
      { name: 'arXiv', href: 'https://arxiv.org/', description: 'Preprints in CS, math, and related fields.' },
      { name: 'Google Scholar', href: 'https://scholar.google.com/', description: 'Paper discovery and citation search.' },
      { name: 'Semantic Scholar', href: 'https://www.semanticscholar.org/', description: 'AI-powered academic search engine.' },
    ],
  },
];
---

<Layout title="CS Resources - Intro to CSE" description="Curated resources for learning computer science, programming, and more." showGlassyBackground={true} glassyConfig={{ color: "rgba(162, 89, 255, 0.1)", opacity: 0.15, blur: "25px" }}>
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[#a259ff] mb-4">Resources</h1>
      <p class="text-lg md:text-xl text-[#d1b3ff] mb-8">Really wanted to gatekeep this, but have fun !</p>
    </div>
    <div class="mx-auto max-w-4xl flex flex-col gap-12 mt-10">
      {
        resourceSections.map((section) => (
          <section class="bg-gradient-to-br from-[#23272f99] via-[#1a1d23cc] to-[#23272f99] border border-[#a259ff] rounded-2xl p-6 shadow-xl">
            <h2 class="text-2xl font-bold text-[#a259ff] mb-2">{section.title}</h2>
            <p class="text-[#d1b3ff] mb-2">{section.description}</p>
            <ul class="list-disc list-inside text-[#d1b3ff] space-y-1">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[#a259ff] underline hover:text-white" target="_blank" rel="noopener noreferrer">{link.name}</a>
                  {' - '}
                  {link.description}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
      <!-- IIITK Specific -->
    <div class="mx-auto max-w-3xl text-center mt-16">
      <p class="text-[#d1b3ff]">Have a great resource to suggest? <a href="/contribute" class="text-[#a259ff] underline hover:text-white">Contribute here</a>!</p>
    </div>
  </section>
</Layout>
